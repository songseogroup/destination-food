# Destination Whisky — CMS admin
# Copy to .env.local and fill in.

# NestJS API base URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Public storefront URL, used by the "Preview" buttons.
# The CMS and the customer site are separate apps on separate origins, so
# Preview needs an absolute URL. Without this the button falls back to
# http://localhost:3000.
# Production: https://destinationwhisky.life
NEXT_PUBLIC_SITE_URL=http://localhost:3000
