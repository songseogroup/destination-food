# Destination Whisky — customer site
# Copy to .env.local and fill in.

# NestJS API base URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Google Sign-In.
# Must be the SAME OAuth 2.0 Web client id set as GOOGLE_CLIENT_ID on the
# backend — the backend verifies the token's `aud` claim against it, so a
# mismatch fails every sign-in.
# Add http://localhost:3000 and https://destinationwhisky.life to the client's
# "Authorized JavaScript origins" in the Google Cloud Console.
# Until this is set, the login/signup pages render a disabled Google button
# explaining that it isn't configured.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
