# Database Configuration
# MySQL Configuration (for reference)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=byfoods_cms

DATABASE_URL="postgresql://postgres.wotbbtbotcsazxrihqry:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

DIRECT_URL="postgresql://postgres.wotbbtbotcsazxrihqry:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
FRONTEND_URL=http://localhost:3000
# Owner dashboard (Stripe Connect return/refresh URLs); falls back to FRONTEND_URL if unset
CMS_ADMIN_URL=http://localhost:3002

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@byfoods.com
# Google Sign-In (customer site)
# Create an OAuth 2.0 Client ID (type: Web application) in the Google Cloud
# Console, add your site origins to "Authorized JavaScript origins"
# (http://localhost:3000 and https://destinationwhisky.life).
# The SAME client id must be set on the frontend as NEXT_PUBLIC_GOOGLE_CLIENT_ID —
# the backend verifies the token's `aud` against this value, so they must match.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Public storefront URL, used by the CMS "Preview" buttons.
# Set NEXT_PUBLIC_SITE_URL in cms-admin's env to the same value.
SITE_URL=http://localhost:3000

# Super admin bootstrap.
# seedDatabase() creates a SUPER_ADMIN with these on first boot ONLY if the
# email does not already exist. There is no hardcoded default any more — leave
# these unset and no administrator is created (the app warns instead).
#
# To reset an EXISTING database (the seed skips emails that already exist):
#   SUPER_ADMIN_EMAIL=you@destinationwhisky.life \
#   SUPER_ADMIN_PASSWORD='<your password>' \
#   CONFIRM=yes node scripts/reset-super-admin.js
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
